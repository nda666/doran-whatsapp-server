# One shared application pool: concurrency 32 plus headroom for dashboard/webhooks.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE?connection_limit=40&pool_timeout=10"
NEXTAUTH_SECRET="REPLACE_WITH_EXISTING_SECRET"
PORT=3000
HOST=127.0.0.1
APP_URL=https://dashboard.jeblast.com
NEXTAUTH_URL=https://dashboard.jeblast.com
NEXTAUTH_URL_INTERNAL=http://127.0.0.1:3000
NEXT_PUBLIC_APP_URL=https://dashboard.jeblast.com
# Preserve this key across deployments/backups. Changing it makes existing encrypted settings unreadable.
SETTINGS_ENCRYPTION_KEY="REPLACE_WITH_A_STABLE_RANDOM_SECRET"
# Used only by deployment/initialize-postmark-setting.cjs; runtime reads postmark-server-token from Global Settings.
POSTMARK_SERVER_TOKEN="REPLACE_WITH_POSTMARK_SERVER_TOKEN"
# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
AUTH_TRUST_PROXY=false
WHATSAPP_ENABLED=false
QUEUE_ENABLED=false
DISPATCH_QUEUE_ENABLED=true
DISPATCH_CONCURRENCY=32
DISPATCH_INTERVAL_MIN_MS=2000
DISPATCH_INTERVAL_MAX_MS=5000
SSL_CERTBOT_ENABLED=false
# Only enable on a VPS with certbot installed and a configured ACME webroot.
# SSL_WEBROOT=/home/jeblast/public_html/dashboard.jeblast.com
WHATSAPP_AUTH_FOLDER=./storage/whatsapp-auth
WHATSAPP_LOG=./storage/logs/whatsapp-logs
# 32 random bytes encoded as 64 hex characters. Preserve across deployments/backups.
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AI_SECRET_KEY=
WEBSITE_LOG=./storage/logs/website

# Custom Telegram provider (server only). Test mode sends REAL messages.
TELEGRAM_BASE_URL=https://tele.jeblast.com
TELEGRAM_API_KEY=REPLACE_WITH_PROVIDER_API_KEY
TELEGRAM_TEST_MODE=true
TELEGRAM_TEST_PHONE=
# Uses the same DISPATCH_QUEUE_ENABLED and device/global policies as WhatsApp.
TELEGRAM_ENABLED=false
# Optional, only for the trusted server enqueueTelegram() helper.
TELEGRAM_DEVICE_ID=
# Set only after confirming the provider response schema; empty = unknown.
TELEGRAM_SUCCESS_FIELD=
TELEGRAM_SUCCESS_VALUE_JSON=true
