{
  "name": "doran-whatsapp-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:next": "next",
    "dev": "node deployment/watch-typescript.cjs server",
    "dev:nodemon": "npm run dev",
    "dev:ts": "node deployment/run-typescript.cjs server",
    "build": "next build && tsc --project tsconfig.server.json",
    "build:tsc": "tsc --project tsconfig.server.json ",
    "build:next": "next build",
    "start": "NODE_ENV=production node dist/src/server/index.js",
    "start:next": "next --max-old-space-size=4096 start",
    "lint": "next lint",
    "prisma": "prisma",
    "migration:create": "prisma migrate dev --create-only",
    "migrate": "prisma migrate dev",
    "migrate:prod": "prisma migrate deploy",
    "worker": "node deployment/run-typescript.cjs worker",
    "worker:dev": "node deployment/watch-typescript.cjs worker"
  },
  "prisma": {
    "seed": "node  ./prisma/seeds/seeder.js"
  },
